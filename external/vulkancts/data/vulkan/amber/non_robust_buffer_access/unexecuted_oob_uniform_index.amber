# Overview of the test:
#   A storage buffer load is guarded by a condition that is never true at
#   runtime. The load index comes from a push constant, so the address is
#   dynamically uniform and not a compile-time constant, and it lies far
#   outside the 16-element buffer. The guarded load must not be executed,
#   so every fragment must write green.

SHADER vertex vert_shader PASSTHROUGH

SHADER fragment frag_shader GLSL
#version 450
layout(push_constant) uniform PC { uint index; } pc;
layout(set = 0, binding = 0) readonly buffer B { vec4 values[16]; };
layout(location = 0) out vec4 outColor;
void main()
{
    vec4 color = vec4(0.0, 1.0, 0.0, 1.0);
    if (pc.index <= 15u)
        color = values[pc.index];
    outColor = color;
}
END

# 0x0F000000: far beyond the 16-element storage buffer.
BUFFER index_pc DATA_TYPE uint32 DATA
251658240
END

BUFFER values DATA_TYPE vec4<float> STD430 SIZE 16 FILL 1.0

BUFFER framebuffer FORMAT R8G8B8A8_UNORM

PIPELINE graphics pipeline
  ATTACH vert_shader
  ATTACH frag_shader
  FRAMEBUFFER_SIZE 32 32
  BIND BUFFER framebuffer AS color LOCATION 0
  BIND BUFFER index_pc AS push_constant
  BIND BUFFER values AS storage DESCRIPTOR_SET 0 BINDING 0
END

CLEAR_COLOR pipeline 0 0 255 255
CLEAR pipeline
RUN pipeline DRAW_RECT POS 0 0 SIZE 32 32

EXPECT framebuffer IDX 0 0 SIZE 32 32 EQ_RGBA 0 255 0 255
